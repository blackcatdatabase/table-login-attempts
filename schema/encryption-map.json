{
  "tables": {
    "login_attempts": {
      "columns": {
        "attempted_at": {
          "strategy": "passthrough"
        },
        "auth_event_id": {
          "strategy": "passthrough"
        },
        "id": {
          "strategy": "passthrough"
        },
        "ip_hash": {
          "context": "db.hmac.login_attempts.ip_hash",
          "key_version_column": "ip_hash_key_version",
          "strategy": "hmac",
          "write_key_version": true
        },
        "ip_hash_key_version": {
          "strategy": "passthrough"
        },
        "success": {
          "strategy": "passthrough"
        },
        "user_id": {
          "strategy": "passthrough"
        },
        "username_hash": {
          "context": "db.hmac.login_attempts.username_hash",
          "key_version_column": "username_hash_key_version",
          "strategy": "hmac",
          "write_key_version": true
        },
        "username_hash_key_version": {
          "strategy": "passthrough"
        }
      }
    }
  }
}